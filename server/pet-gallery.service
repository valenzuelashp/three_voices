[Unit]
Description=Pet photo gallery for the advocacy site
After=network.target

[Service]
User=petgallery
Group=petgallery
WorkingDirectory=/opt/pet-gallery
Environment=PET_GALLERY_ROOT=/var/lib/pet-gallery
Environment=PET_PUBLIC_PREFIX=/pets
ExecStart=/usr/bin/python3 /opt/pet-gallery/server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pet-gallery

[Install]
WantedBy=multi-user.target
